# Data: raw downloads and intermediate tables are rebuilt by `make pull`.
# data/processed/ (draft_outcomes.parquet, quality_report.json) is committed: the app reads it.
data/raw/*
data/interim/*
!data/raw/.gitkeep
!data/interim/.gitkeep

# Python / tooling
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# OS
.DS_Store
